+#[test]
+fn host_export_is_not_saved_until_acknowledged_and_stale_ack_keeps_edits() {
+    let (mut app, _) = app_with(vec![]);
+    app.open_file("image.pcraft", b"image").unwrap();
+    app.run("layer.new.layer", json!({"name":"Retouch"})).unwrap();
+    app.services.host_write = Some(|_, _, _, _, _, _| Ok(()));
+    let st = app.session.active().unwrap();
+    let (id, revision) = (st.doc.id.0, st.revision);
+    assert!(app.write_document("saved.pcraft".into(), &crate::ExportSettings::default(), false).unwrap().is_none());
+    assert!(app.session.active().unwrap().is_dirty());
+    app.run("layer.new.layer", json!({"name":"Newer edit"})).unwrap();
+    app.complete_host_save(id, revision, "saved.pcraft", &[], false, &egui::Context::default());
+    assert!(app.session.active().unwrap().is_dirty());
+    let revision = app.session.active().unwrap().revision;
+    app.complete_host_save(id, revision, "saved.pcraft", &[], false, &egui::Context::default());
+    assert!(!app.session.active().unwrap().is_dirty());
+}
